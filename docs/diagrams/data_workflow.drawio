<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Data Workflow" id="data-workflow">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1370" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="postgres-airflow-dbt-snowflake &#8212; ELT pipeline" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1280" height="30" as="geometry" />
        </mxCell>

        <!-- Postgres group -->
        <mxCell id="pgGroup" value="source_postgres&#10;(operational DB, schema app)" style="rounded=1;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="240" height="500" as="geometry" />
        </mxCell>
        <mxCell id="pgBox" value="7 tables&lt;br&gt;&#8226; customers (800)&lt;br&gt;&#8226; agents (30)&lt;br&gt;&#8226; products (6)&lt;br&gt;&#8226; policies (1,000)&lt;br&gt;&#8226; premium_payments (~2,700)&lt;br&gt;&#8226; claims (400)&lt;br&gt;&#8226; claim_payments (~350)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="pgNote" value="Deterministic mimic data&#10;(setseed fixed &#8594; byte-identical rebuilds)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- Airflow group -->
        <mxCell id="afGroup" value="Airflow DAG: postgres_to_snowflake&#10;(schedule=None, manual trigger)" style="rounded=1;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="70" width="260" height="560" as="geometry" />
        </mxCell>
        <mxCell id="taskExtract" value="extract_to_files&#10;PostgresHook &#8594; pandas.read_sql&#10;&#8594; one Parquet file per table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="110" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="taskUpload" value="upload_to_stage&#10;SnowflakeHook: PUT file &#8594;&#10;@RAW.AIRFLOW_STAGE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="220" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="taskCopy" value="copy_into_raw&#10;TRUNCATE TABLE RAW.&lt;T&gt; +&#10;COPY INTO (full snapshot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="330" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="taskDbtRun" value="dbt_run&#10;DockerOperator: fresh dbt&#10;container &#8594; dbt run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="440" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="taskDbtTest" value="dbt_test&#10;DockerOperator: dbt test&#10;(~53 data tests)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="550" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Snowflake group -->
        <mxCell id="sfGroup" value="Snowflake &#8212; ANALYTICS_DB_&lt;DEV|PROD&gt;" style="rounded=1;html=1;fillColor=none;strokeColor=#1155cc;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1020" y="70" width="300" height="560" as="geometry" />
        </mxCell>
        <mxCell id="rawBox" value="RAW schema&lt;br&gt;RAW.CUSTOMERS, RAW.AGENTS,&lt;br&gt;RAW.PRODUCTS, RAW.POLICIES,&lt;br&gt;RAW.PREMIUM_PAYMENTS,&lt;br&gt;RAW.CLAIMS, RAW.CLAIM_PAYMENTS&lt;br&gt;(1:1 copy + _loaded_at)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#1155cc;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="110" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="stagingBox" value="ANALYTICS_STAGING&lt;br&gt;stg_customers, stg_agents,&lt;br&gt;stg_products, stg_policies,&lt;br&gt;stg_premium_payments,&lt;br&gt;stg_claims, stg_claim_payments&lt;br&gt;(views, light renames)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#1155cc;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="290" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="martsBox" value="ANALYTICS_MARTS&lt;br&gt;dim_customers, dim_policies,&lt;br&gt;fct_claims,&lt;br&gt;fct_premium_payments&lt;br&gt;(tables: joins + roll-ups)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#1155cc;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="470" width="260" height="130" as="geometry" />
        </mxCell>

        <!-- Edges: source -> extract -->
        <mxCell id="e1" value="reads app.* (7 tables)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="pgBox" target="taskExtract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges within Airflow (sequential) -->
        <mxCell id="e2" value="Parquet &#8594; ./data&#10;(XCom manifest)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="taskExtract" target="taskUpload">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="taskUpload" target="taskCopy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="taskCopy" target="taskDbtRun">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="taskDbtRun" target="taskDbtTest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: Airflow -> Snowflake -->
        <mxCell id="e6" value="TRUNCATE + COPY INTO&#10;(MATCH_BY_COLUMN_NAME)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="taskCopy" target="rawBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="dbt run (builds views)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="taskDbtRun" target="stagingBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="dbt test (~53 checks)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="taskDbtTest" target="martsBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges within Snowflake (dbt lineage) -->
        <mxCell id="e9" value="dbt source&#10;(_staging__sources.yml)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="rawBox" target="stagingBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="joins + roll-ups" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="stagingBox" target="martsBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Footnote -->
        <mxCell id="note" value="DBT_TARGET (dev | prod) selects the whole Snowflake database for the run &#8212; ANALYTICS_DB_DEV or ANALYTICS_DB_PROD.&#10;Same account, warehouse (COMPUTE_WH) and role; only the database differs. dbt runs in its own container via DockerOperator." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="640" width="980" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
