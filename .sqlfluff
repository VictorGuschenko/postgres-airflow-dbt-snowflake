# Offline SQL linting for dbt models (CI step 3 — no warehouse connection).
# Uses the jinja templater with dbt built-ins stubbed, so ref()/source()/config()
# resolve without running dbt. Style rules kept light; tighten as you like.
[sqlfluff]
dialect = snowflake
templater = jinja
max_line_length = 120
# RF01: false positives on stubbed ref()/source() relations
# AL01/ST09: implicit table aliases and join-order are allowed here
# ST06/ST07: don't enforce select-clause / join ordering
exclude_rules = RF01, RF03, RF04, AL01, ST06, ST07, ST09

[sqlfluff:templater:jinja]
apply_dbt_builtins = true

# Allow column aliases to be aligned within the SELECT clause.
[sqlfluff:layout:type:alias_expression]
spacing_before = align
align_within = select_clause
align_scope = bracketed

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower
