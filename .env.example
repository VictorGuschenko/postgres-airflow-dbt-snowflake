# Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# --- Airflow ---------------------------------------------------------------
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.1
# On Linux set to your host uid (`id -u`); 50000 is fine on macOS/Windows.
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Absolute path to this repo on the Docker host — required for the DockerOperator
# that launches the dbt container (bind-mounts ./dbt). e.g. /Users/you/Projects/postgres-airflow-dbt-snowflake
HOST_PROJECT_DIR=

# --- Source Postgres -----------------------------------------------------
SOURCE_POSTGRES_USER=source
SOURCE_POSTGRES_PASSWORD=source
SOURCE_POSTGRES_DB=source
SOURCE_POSTGRES_PORT=5433

# --- Airflow connections (picked up automatically as AIRFLOW_CONN_*) -----
AIRFLOW_CONN_SOURCE_POSTGRES=postgresql://source:source@source_postgres:5432/source
# Snowflake connection as JSON (edit the values):
AIRFLOW_CONN_SNOWFLAKE_DEFAULT={"conn_type":"snowflake","login":"MY_USER","password":"MY_PASSWORD","schema":"RAW","extra":{"account":"MY_ACCOUNT","warehouse":"COMPUTE_WH","database":"RAW_DB","role":"MY_ROLE"}}

# --- Snowflake (consumed by the dbt container via profiles.yml) ---------
SNOWFLAKE_ACCOUNT=MY_ACCOUNT
SNOWFLAKE_USER=MY_USER
SNOWFLAKE_PASSWORD=MY_PASSWORD
SNOWFLAKE_ROLE=MY_ROLE
SNOWFLAKE_DATABASE=ANALYTICS_DB
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_THREADS=4
