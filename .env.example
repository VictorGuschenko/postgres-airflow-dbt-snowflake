# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored — never commit it.
#
# Every value below is a PLACEHOLDER. Replace each <...> and every "change-me"
# with your own. The non-secret project conventions (image tags, the
# COMPUTE_WH / ANALYTICS_DB names that snowflake/bootstrap.sql creates) are left
# concrete so the walkthrough in README.md works as written.
# ---------------------------------------------------------------------------

# --- Airflow --------------------------------------------------------------
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.1
# On Linux set to your host uid (`id -u`); 50000 is fine on macOS/Windows.
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Airflow web UI login, created on first startup. Pick your own.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change-me
# Absolute path to this repo on the Docker host — required for the DockerOperator
# that launches the dbt container (bind-mounts ./dbt).
# e.g. /Users/you/Projects/postgres-airflow-dbt-snowflake
HOST_PROJECT_DIR=

# --- Source Postgres ----------------------------------------------------
# A throwaway local container, so this is not a real secret — but choose your
# own values instead of shipping someone else's.
SOURCE_POSTGRES_USER=insurance_app
SOURCE_POSTGRES_PASSWORD=change-me
SOURCE_POSTGRES_DB=insurance
SOURCE_POSTGRES_PORT=5433

# --- Airflow connection to the source database (auto-read as AIRFLOW_CONN_*) --
# Keep user / password / db in sync with the three SOURCE_POSTGRES_* values above.
AIRFLOW_CONN_SOURCE_POSTGRES=postgresql://insurance_app:change-me@source_postgres:5432/insurance

# --- Environment ----------------------------------------------------------
# dev | prod. Selects the isolated Snowflake database ANALYTICS_DB_<TARGET>
# for both the Airflow RAW load and the dbt run/test. Run
# snowflake/bootstrap.sql + raw_tables.sql once per environment.
DBT_TARGET=dev

# --- Snowflake --------------------------------------------------------------
# Single source of truth. Consumed by the dbt container (profiles.yml) AND
# assembled into the Airflow connection AIRFLOW_CONN_SNOWFLAKE_DEFAULT in
# docker-compose.yaml. SNOWFLAKE_DATABASE is the BASE name; the pipeline appends
# _DEV / _PROD (so this stays ANALYTICS_DB).
# Account identifier is <orgname>-<account_name> (Snowsight: Admin > Accounts).
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USER=<your-snowflake-user>
SNOWFLAKE_PASSWORD=<your-snowflake-password>
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ANALYTICS_DB
# Schema dbt builds into (staging/marts get suffixed from this base).
SNOWFLAKE_SCHEMA=ANALYTICS
# Schema Airflow lands raw extracts into.
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_THREADS=4
